# 1. Start with Python 3.11
FROM python:3.11-slim

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Copy our API dependencies
COPY requirements-api.txt .

# 4. Install the dependencies
RUN pip install --no-cache-dir -r requirements-api.txt

# 5. Copy our FastAPI application
COPY main.py .

# 6. Copy our trained ML model
COPY artifacts/intent_classifier.joblib artifacts/intent_classifier.joblib

# 7. Document the API port
EXPOSE 8000

# 8. Start the API server
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]